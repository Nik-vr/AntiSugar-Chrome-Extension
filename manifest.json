{
  "manifest_version": 3,
  "name": "АнтиСахар — оценка товара",
  "version": "1.4.17",
  "description": "Показывает значок с оценкой безопасности товара на странице товара: анализ состава по зонам риска сахарозаменителей.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "АнтиСахар"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["defaults.js", "extractor.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
